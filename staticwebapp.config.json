{
  "routes": [
    {
      "route": "/apex-ds/*",
      "redirect": "/DS/DS/index.html",
      "statusCode": 301
    },
    {
      "route": "/apex-dr/*",
      "redirect": "/DS/DR/index.html",
      "statusCode": 301
    },
    {
      "route": "/apex-do/*",
      "redirect": "/DS/DO/index.html",
      "statusCode": 301
    },
    {
      "route": "/ds/*",
      "redirect": "/DS/index.html",
      "statusCode": 301
    },
    {
      "route": "/dx/*",
      "redirect": "/DX/index.html",
      "statusCode": 301
    },
    {
      "route": "/gagemap/*",
      "redirect": "/GageMap/index.html",
      "statusCode": 301
    },
    {
      "route": "/dxplus/*",
      "redirect": "/DX+/index.html",
      "statusCode": 301
    },
    {
      "route": "/deployment/*",
      "statusCode": 404
    }
  ],
  "responseOverrides": {
    "404": {
      "rewrite": "/404.html",
      "statusCode": 404
    }
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "SAMEORIGIN",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  },
  "mimeTypes": {
    ".json": "application/json",
    ".svg": "image/svg+xml",
    ".woff2": "font/woff2",
    ".pdf": "application/pdf"
  }
}
